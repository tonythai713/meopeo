# Le dépôt GitHub (public, sert GitHub Pages) ne contient QUE les fichiers de l'app.
# Restent uniquement sur le PC : notes de travail (CLAUDE.md, README.md), page et données de test, scripts SQL.
/*
!/.gitignore
!/.nojekyll
!/index.html
!/app.js
!/mascot.js
!/bigtino.js
!/data.js
!/config.js
!/style.css
!/manifest.webmanifest
!/sw.js
!/background.jpg
!/icons/
!/widget.html
!/widget/
!/art/
/art/*
!/art/big-tino.jpg
!/art/decor-template-phone.png
!/art/decor-template-desktop.png
